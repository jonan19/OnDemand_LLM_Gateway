# Copy to .env (never commit .env) and run:  uvicorn main:app --env-file .env

# URL of the GPU worker (llama-server). No trailing slash needed.
# Local llama-server:      http://127.0.0.1:8080
# Kaggle/RunPod via tunnel: https://<something>.trycloudflare.com
WORKER_URL=http://127.0.0.1:8080

# How many of the most recent stored messages are sent to the model on each request.
SLIDING_WINDOW_TURNS=10

# Default max tokens per reply when the client doesn't specify one.
DEFAULT_MAX_TOKENS=256

# --- Planned for later phases (not read yet) ---
# IDLE_TIMEOUT_SECONDS=600
# PROVIDER_API_KEY=
